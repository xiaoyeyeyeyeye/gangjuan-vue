{{#if state}}
const state = {
  token: '',
  user: {}
}
{{/if}}

{{#if mutations}}
const mutations = {
  SET_TOKEN(state, token) {
    state.token = token
  },
  SET_USER(state, user) {
    state.user = user
  }
}
{{/if}}

{{#if actions}}
const actions = {}
{{/if}}

export default {
  namespaced: true,
  state,
  mutations,
  actions,
  {{options}}
}
